# Copy to .env (gitignored) and adjust.

# Host port published to Odoo HTTP
HOST_PORT=8069

# Official Odoo image Postgres wiring (container env HOST/USER/PASSWORD)
HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo

# Postgres container (must match USER / PASSWORD)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres

# Application database created on first start
ODOO_DB=isd

# Odoo master password (database manager is hidden after init)
ADMIN_PASSWD=admin

# Optional live services — not required to start or install addons
# ANTHROPIC_API_KEY=
# SEPAY_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
